# Track only application sources and repository controls at the root.
/*
!/.gitignore
!/README.md
!/DESKTOP.md
!/VALIDATION.md
!/.githooks/
!/scripts/
!/src/
!/src-tauri/
!/public/
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
# Personal documents, backups and generated output
.private/
*.cv.json
*.zip
.env
.env.*
node_modules/
dist/
*.tsbuildinfo
.DS_Store
/public/*
